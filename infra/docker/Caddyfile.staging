{
  servers {
    protocols h1 h2
  }
}

{$VRATA_APP_DOMAIN} {
  # The integration API is reached only from the target's internal network.
  @platform_integration path /integration /integration/*
  respond @platform_integration "not found" 404

  @versioned_app_scene_assets path_regexp versionedAppSceneAssets ^/assets/scenes/[^/]+/[0-9a-fA-F]{40}/.+$
  handle @versioned_app_scene_assets {
    root * {$VRATA_STAGING_SCENE_ROOT:/srv/runtime-public}
    header Access-Control-Allow-Origin *
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle /assets/scenes/* {
    root * {$VRATA_STAGING_SCENE_ROOT:/srv/runtime-public}
    header Access-Control-Allow-Origin *
    header Cache-Control "no-cache, must-revalidate"
    file_server
  }

  reverse_proxy api:4000 {
    header_up X-Vrata-Client-IP {remote_host}
    header_up X-Vrata-Proxy-Auth "{$VRATA_IDENTITY_PROXY_TOKEN}"
  }
}

{$VRATA_STATE_DOMAIN} {
  @versioned_state_scene_assets path_regexp versionedStateSceneAssets ^/assets/scenes/[^/]+/[0-9a-fA-F]{40}/.+$
  handle @versioned_state_scene_assets {
    root * {$VRATA_STAGING_SCENE_ROOT:/srv/runtime-public}
    header Access-Control-Allow-Origin *
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle /assets/scenes/* {
    root * {$VRATA_STAGING_SCENE_ROOT:/srv/runtime-public}
    header Access-Control-Allow-Origin *
    header Cache-Control "no-cache, must-revalidate"
    file_server
  }

  reverse_proxy room-state:2567
}

{$VRATA_LIVEKIT_DOMAIN} {
  reverse_proxy livekit:7880
}

{$VRATA_STORAGE_DOMAIN} {
  # Public scene objects only: GET/HEAD (and CORS preflight) of a non-empty key in the public
  # bucket, without a query string. Writes, listings, the private plugin bucket and S3 subresources stay on
  # the internal network; everything else is refused with 403, which the private storage probe expects.
  # Caddy path matchers see a cleaned, case-insensitive path while the proxy forwards the original, so one
  # expression checks the raw request: exact bucket prefix, a key, no query, no dot or empty segments and no
  # encoded separators. Separate expression lines in one matcher are not combined with AND. Room documents
  # live in the private bucket and are released only by the API; their key prefix is refused here as well, so
  # that a copy left in the public bucket by an earlier release is not served before it is moved.
  @public_object {
    method GET HEAD OPTIONS
    expression `{path}.startsWith("/{$MINIO_BUCKET}/") && {path} != "/{$MINIO_BUCKET}/" && {query} == ""
      && !{path}.startsWith("/{$MINIO_BUCKET}/documents/")
      && !{uri}.matches("(?i)%2f|%5c|%00|%2e") && !{path}.matches("(^|/)\\.{1,2}(/|$)") && !{path}.contains("//")`
  }
  handle @public_object {
    reverse_proxy minio:9000
  }
  respond 403
}

{$VRATA_BROWSER_DOMAIN} {
  handle /frames* {
    reverse_proxy remote-browser:4010
  }

  respond "not found" 404
}
