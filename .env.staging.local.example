# Copy to .env.staging.local or generate with:
# pnpm staging:e2e:pull-env -- --ssh <user>@<current-staging-ip>
# Do not put real values in git.
BASE_URL=https://<current-staging-ip>.sslip.io
STAGING_ASSET_BASE_URL=https://state.<current-staging-ip>.sslip.io
STAGING_ADMIN_TOKEN=REPLACE_WITH_STAGING_ADMIN_TOKEN
STAGING_SCENE_BUNDLE_VERSION=REPLACE_WITH_DEPLOYED_SHA
